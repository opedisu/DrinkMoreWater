# Prefer `npm run setup`, which generates the secrets below, writes this file
# as .env.local with 0600 permissions and can push them straight to Railway or
# Vercel without printing them.

# ---- required ----

# Postgres connection string (Neon, Supabase, Vercel Postgres, or your own).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Web Push keys. Generate with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the reminder scheduler must present. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ---- optional ----

# Public URL of the deployment. Used to build magic links. Falls back to the
# request host, which is correct on Vercel.
APP_URL=https://your-app.vercel.app

# Email delivery for sign-in links. Without this, links are printed to the
# server log instead (fine for local development, not for production).
RESEND_API_KEY=
EMAIL_FROM=DrinkMoreWater <onboarding@resend.dev>

# Only for a Postgres provider with a self-signed certificate. Setting this
# disables certificate verification, so leave it unset unless you must.
# DATABASE_SSL_NO_VERIFY=true
